# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
# Local docker compose database (see docker-compose.yml)
DATABASE_URL=postgres://fivediamonds:fivediamonds_dev_only@localhost:5442/fivediamonds
TEST_DATABASE_URL=postgres://fivediamonds:fivediamonds_dev_only@localhost:5442/fivediamonds_test
# 32+ random characters. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string-for-local-dev
# Public origin of the web app (cookies, CSRF origin checks, email links)
APP_ORIGIN=http://localhost:5173
API_PORT=4000
# Comma-separated extra trusted origins (optional)
TRUSTED_ORIGINS=
# Mail: dev-mailbox (stores messages in DB, dev only) | smtp
MAIL_DRIVER=dev-mailbox
MAIL_FROM="5 Diamonds Tournament Baseball <no-reply@example.invalid>"
SMTP_URL=
# Payments: disabled | simulated (simulated is refused in production)
PAYMENT_PROVIDER=disabled
# Storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PRIVATE=
S3_BUCKET_PUBLIC=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Require TOTP MFA for staff roles (should be true in production)
STAFF_MFA_REQUIRED=false
LOG_LEVEL=info
